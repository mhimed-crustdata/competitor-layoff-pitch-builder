# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# How far back a leaver counts as "just left"
SINCE_DAYS=45

# Optional: where the Crustdata company watch posts headcount-drop events (used by `watch`)
WATCH_WEBHOOK_URL=

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
